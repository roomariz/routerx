# RouterX Environment Variables
# Copy this file to .env and fill in your API keys

# API Keys (required)
# Use OPENROUTER_API_KEY, OPENAI_API_KEY, or GEMINI_API_KEY
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional Configuration
# These values will override the defaults in config.example.json if provided
# DEFAULT_MODEL=openai/gpt-4o-mini
# DEFAULT_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_SAVE_PATH=./outputs
# MAX_RETRIES=3
# TIMEOUT=30000
# ROUTERX_HTTP_REFERER=https://your-app-domain.example.com
# ROUTERX_CLIENT_TITLE=Your App Name

# Example of using OpenAI instead of OpenRouter:
# OPENAI_API_KEY=your_openai_api_key_here
# DEFAULT_BASE_URL=https://api.openai.com/v1
