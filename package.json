{
  "name": "routerx",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "bin": {
    "routerx": "./index.js"
  },
  "scripts": {
    "test": "node test-runner.js",
    "test:unit": "node test-runner.js && echo 'Unit tests are in tests/unit/'",
    "test:all": "node --experimental-vm-modules ./node_modules/.bin/jest --no-cache",
    "test:watch": "node --experimental-vm-modules ./node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/.bin/jest --coverage --no-cache",
    "benchmark": "node benchmark.js"
  },
  "keywords": [
    "cli",
    "ai",
    "openrouter",
    "llm",
    "chatgpt",
    "gpt-4",
    "gpt-4o-mini",
    "ai-cli",
    "terminal",
    "command-line",
    "ai-tools",
    "openrouter-api",
    "configurable"
  ],
  "author": {
    "name": "RouterX Contributors"
  },
  "license": "MIT",
  "description": "A lightweight CLI for interacting with OpenRouter models and AI services. Provides chat capabilities, model listing, and code assistance directly from your terminal.",
  "homepage": "https://github.com/open-source/routerx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-source/routerx.git"
  },
  "bugs": {
    "url": "https://github.com/open-source/routerx/issues"
  },
  "files": [
    "index.js",
    "README.md",
    "package.json",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "config.example.json"
  ],
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-jest": "^30.2.0",
    "jest": "^29.7.0"
  }
}
